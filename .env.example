# 自宅PC用の秘密情報の見本。これをコピーして .env という名前にし、値を入れる（.env はコミットしない）。
# 値の入手先は README.md「6. .env を作る」を参照。

# ---- ローカルLLM（Strata）のAPIキー。Strata の起動時にも同じ値を使う ----
LOCAL_LLM_API_KEY=

# ---- 既読管理の置き場所（git 管理外） ----
INFO_DIGEST_STATE_DIR=D:\info-digest\.local\state

# ---- Discord ウェブフック（チャンネルの 設定 → 連携サービス → ウェブフック） ----
DISCORD_WEBHOOK_AI=
DISCORD_WEBHOOK_AI_GLOBAL=
DISCORD_WEBHOOK_ONCO=
DISCORD_WEBHOOK_NOTE=
DISCORD_WEBHOOK_NEWS=

# ---- Discord Bot（疑問深堀り・しらべ）：開発者ポータルで作成、Message Content Intent を ON ----
DISCORD_BOT_TOKEN=
DISCORD_QA_CHANNEL_ID=
DISCORD_CHAT_CHANNEL_ID=
DISCORD_CHAT_WEBHOOK_URL=

# ---- Discord Bot（ルナ）：別アカウントの Bot ----
DISCORD_LUNA_BOT_TOKEN=
DISCORD_LUNA_CHANNEL_ID=

# ---- 任意：Claude API（config.yaml で provider: anthropic にしたときだけ） ----
# ANTHROPIC_API_KEY=
